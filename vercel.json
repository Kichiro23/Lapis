{
  "version": 2,
  "builds": [
    {
      "src": "app/server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "app/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "app/server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "app/dist/$1"
    }
  ]
}
